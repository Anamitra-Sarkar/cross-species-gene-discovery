# Environment variables for Cross-Species Gene Discovery
# Copy this file to .env and fill in real values where needed.
# Never commit real secrets. All values below are safe placeholders.

# ── Backend: release gate (fail-closed) ──────────────────────────────────────
# Gate is OPEN only if BOTH are set: MODEL_RELEASE_APPROVED=true AND APPROVED_ARTIFACT_REVISION non-empty.
# Even then, MODEL_ARTIFACT_PATH must point to an existing graph artifact or the backend stays not-ready.

# Set to "true" to approve serving an approved model artifact (default: closed/false).
MODEL_RELEASE_APPROVED=false

# Revision/tag of the approved artifact (e.g. git SHA, semantic version). Required if gate is open.
APPROVED_ARTIFACT_REVISION=

# Path to the approved graph artifact produced by `python -m data_pipeline.build_graph --output <path>`.
# Example: data/graph.json or data/graph.pt
MODEL_ARTIFACT_PATH=

# ── Backend: auth ────────────────────────────────────────────────────────────
# Path to Firebase service-account JSON for bearer-token verification (optional).
# If empty/missing, auth runs in permissive mock mode (any structurally-valid token accepted).
FIREBASE_SERVICE_ACCOUNT_JSON=

# If "true", bearer-token auth is strictly enforced (401 without valid JWT). Default "false" = permissive.
FIREBASE_AUTH_ENABLED=false

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base URL for the backend API. The frontend reads this at build time via Vite.
# For local dev with the Vite proxy, leave empty (requests go to same origin and are proxied).
# For production or separate hosts, set e.g. https://api.example.com
VITE_API_URL=

# Legacy alias for VITE_API_URL — both are read by the frontend (VITE_API_URL takes precedence).
VITE_API_BASE=

# ── Optional / infra ─────────────────────────────────────────────────────────
# Port the backend listens on inside Docker (docker-compose maps 8000:8000 by default).
# PORT=8000
